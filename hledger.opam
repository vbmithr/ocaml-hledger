opam-version: "2.0"
synopsis: "Read and write hledger 2.0 journal files"
maintainer: ["Vincent Bernardoff"]
authors: ["Vincent Bernardoff"]
license: "ISC"
homepage: "https://github.com/vbmithr/ocaml-hledger"
bug-reports: "https://github.com/vbmithr/ocaml-hledger/issues"
depends: [
  "dune" {>= "3.10"}
  "ocaml" {>= "5.1"}
  "core"
  "bigdecimal"
  "ppx_jane"
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
